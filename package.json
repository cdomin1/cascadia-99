{
  "name": "vexelon-99",
  "productName": "VEXELON 99",
  "description": "A rising-panel battle game with CPU opponents and room-code multiplayer.",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "VEXELON 99",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "smoke:web": "electron scripts/web-smoke.cjs",
    "desktop": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "godot": "godot --path godot",
    "godot:editor": "godot --editor --path godot",
    "godot:import": "godot --headless --path godot --editor --import --quit",
    "godot:assets": "electron scripts/export-godot-assets.cjs",
    "smoke:godot": "node scripts/godot-smoke.mjs",
    "smoke:godot-ui": "godot --path godot -- --smoke-ui",
    "smoke:godot-audio": "godot --headless --path godot --script res://tests/audio_smoke.gd",
    "smoke:phase1": "node scripts/phase1-smoke.mjs",
    "smoke:retro": "node scripts/retro-vfx-smoke.mjs",
    "tutorials:render": "node scripts/record-tutorials.mjs",
    "smoke:tutorials": "node scripts/tutorials-smoke.mjs",
    "demo:render": "electron scripts/render-demo.cjs",
    "smoke:selector": "node scripts/selector-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.panel99.game",
    "productName": "VEXELON 99",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/address.mjs",
      "desktop/preload.cjs",
      "desktop/assets/icon.png",
      "server.mjs",
      "engine.mjs",
      "match-rules.mjs",
      "records.mjs",
      "bot.mjs",
      "sound.mjs",
      "music.mjs",
      "theme.js",
      "palettes.js",
      "visuals.mjs",
      "demo/gameplay.gif",
      "demo/gameplay.png",
      "index.html",
      "app.mjs",
      "style.css",
      "favicon.svg",
      "logo.svg",
      "fonts/**",
      "package.json",
      "flux-config.mjs",
      "abilities.mjs",
      "presentation-effects.mjs",
      "tutorials.mjs",
      "help-tutorials.mjs",
      "demo/tutorials/**"
    ],
    "artifactName": "VEXELON-99-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "desktop/assets/icon.png",
      "executableName": "vexelon-99"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.puzzle-games",
      "icon": "desktop/assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/assets/icon.png"
    },
    "nsis": {
      "artifactName": "VEXELON-99-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "VEXELON-99-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
